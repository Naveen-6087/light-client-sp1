# =============================================================================
# Sepolia Deployment Configuration
# =============================================================================

# Private key for deployment (DO NOT commit real keys!)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Sepolia RPC URL (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# SP1 Verifier Gateway on Sepolia (Groth16)
# This is the canonical address across all chains for SP1 v6
SP1_VERIFIER_ADDRESS=0x397A5f7f3dBd538f23DE225B51f532c34448dA9B

# Program verification key (from your proof fixture)
PROGRAM_VKEY=0x00c0d2560cdf46cef2bf7972d4fbcb57c292dcd2e6e014fad14afbe3d6820fb2

# Minimum sync committee participation (2/3 of 512 = 342)
MIN_PARTICIPATION=342

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
